	<Include ModelBehaviorFile="FSLTL\Misc\FSLTL_FX_ModNode.xml"/>

	<Component ID="taxi0_vis" Node="taxi0">
		<Visibility>
        	<Parameter>
		<Code>
                	(A:GEAR POSITION:0, Enum) 1 == if{ 1 } els{ 0 }
		</Code>
		</Parameter>
		</Visibility>
	</Component>
	<Component ID="taxi2_vis" Node="taxi2">
		<Visibility>
        	<Parameter>
		<Code>
                	(A:GEAR POSITION:0, Enum) 1 == if{ 1 } els{ 0 }
		</Code>
		</Parameter>
		</Visibility>
	</Component>	


	<Component ID="Flaps">
		<UseTemplate Name="ASOBO_GT_Anim_Code">
			<ANIM_NAME>FLAPS</ANIM_NAME>
			<ANIM_CODE>
            			(A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 1 &lt; if{ (A:LIGHT LANDING, bool) 1 == if{ (A:PLANE ALT ABOVE GROUND, feet) 2000 &lt; if{ (A:VERTICAL SPEED, feet per second) -0.1 &gt; if{ (A:SPOILERS HANDLE POSITION, percent) 1 &gt; if{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 100 } els{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 75 } } els{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 50 } } els{ (A:PLANE ALT ABOVE GROUND, feet) 4000 &lt; if{ (A:VERTICAL SPEED, feet per second) 0.1 &lt; if{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 50 } els{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) 0 } } } } } els{ (A:PLANE ALT ABOVE GROUND, feet) 4500 &lt; if{ (A:TRAILING EDGE FLAPS LEFT PERCENT, percent) } }
			</ANIM_CODE>
			<ANIM_LENGTH>100</ANIM_LENGTH>
			<ANIM_LAG>10</ANIM_LAG>
		</UseTemplate>
	</Component>

	<Component ID="Spoiler">
		<UseTemplate Name="ASOBO_GT_Anim_Code">
			<ANIM_NAME>SPOILERS</ANIM_NAME>
			<ANIM_CODE>
				(A:SPOILERS HANDLE POSITION, percent) 
			</ANIM_CODE>
			<ANIM_LENGTH>100</ANIM_LENGTH>
			<ANIM_LAG>120</ANIM_LAG>
		</UseTemplate>
	</Component>

	<Component ID="GEARS">
		<UseTemplate Name="FSLTL_CompGear_Template">
			<ANIM_NAME>GEAR_center</ANIM_NAME>
			<ID>0</ID>
			<GEAR_ALT>200</GEAR_ALT>
			<ANIM_LENGTH>200</ANIM_LENGTH>
		</UseTemplate>
		<UseTemplate Name="FSLTL_CompGear_Template">
			<ANIM_NAME>GEAR_left</ANIM_NAME>
			<ID>1</ID>
			<GEAR_ALT>200</GEAR_ALT>
			<ANIM_LENGTH>200</ANIM_LENGTH>
		</UseTemplate>
		<UseTemplate Name="FSLTL_CompGear_Template">
			<ANIM_NAME>GEAR_right</ANIM_NAME>
			<ID>2</ID>
			<GEAR_ALT>200</GEAR_ALT>
			<ANIM_LENGTH>200</ANIM_LENGTH>
		</UseTemplate>
	</Component>

	<Component ID="Engines">
		<UseTemplate Name="FSLTL_Engine_Blur">
		        <ANIM_NAME>PropBlur_L</ANIM_NAME>
		        <NODE_NAME>node56_anim_prop0_blurred</NODE_NAME>
		        <RPM_VAR>(A:ENG N1 RPM:1,degrees per second)</RPM_VAR>
		</UseTemplate>
		<UseTemplate Name="FSLTL_Engine_Blur">
	        	<ANIM_NAME>PropBlur_R</ANIM_NAME>
	        	<NODE_NAME>node15_anim_prop1_blurred</NODE_NAME>
		        <RPM_VAR>(A:ENG N1 RPM:2,degrees per second)</RPM_VAR>
		</UseTemplate>
		<UseTemplate Name="FSLTL_Engine_Static">
		        <ANIM_NAME>PropSlow_L</ANIM_NAME>
		        <NODE_NAME>node70_anim_prop0_still</NODE_NAME>
		        <RPM_VAR>(A:ENG N1 RPM:1,degrees per second)</RPM_VAR>
			<WIND_VAR>0</WIND_VAR>
		</UseTemplate>
		<UseTemplate Name="FSLTL_Engine_Static">
		        <ANIM_NAME>PropSlow_R</ANIM_NAME>
