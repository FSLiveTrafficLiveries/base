	<Component ID="Acft_Lights">
	        <UseTemplate Name="FSLTL_FX_LIGHT_CONTROL" />
	</Component>

	<Component ID="FX">
		<UseTemplate Name="FSLTL_FX_EXHAUST_HEAT_DUAL"/>
		<UseTemplate Name="FSLTL_FX_GEAR_FRONT_DUAL"/>
		<UseTemplate Name="FSLTL_FX_GEAR_REAR_DUAL"/>
	</Component>

</Behaviors>
