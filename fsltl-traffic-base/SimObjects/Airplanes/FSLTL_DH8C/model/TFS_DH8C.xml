		<UseTemplate Name="FSLTL_Wheel_Roll_Center">
		        <ANIM_NAME>WHEEL_ROLL_center</ANIM_NAME>
		        <WHEEL_RADIUS>0.2794</WHEEL_RADIUS> <!-- in meters -->
